# frequence-web — örnek ortam değişkenleri.
# Gerçek değerleri bu dosyaya yazmayın; .env.local (git dışı) ve Vercel proje
# ayarlarını kullanın. Sunucu tarafı değerler NEXT_PUBLIC_* ile başlamaz.

# Site kökeni (canonical / OG URL'leri için).
NEXT_PUBLIC_SITE_URL=https://onfrequence.co

# Form hattı. Varsayılan kapalı (none): formlar doğrulanır, gönderim yerine
# ziyaretçiye iletişim e-postası gösterilir. Bir backend'e bağlamak için:
# FORM_SUBMISSION_PROVIDER=webhook + FORM_WEBHOOK_URL (+ FORM_WEBHOOK_SECRET).
FORM_SUBMISSION_PROVIDER=none
# FORM_WEBHOOK_URL=
# FORM_WEBHOOK_SECRET=
